{
  "firestore": {
    "rules": "firestore.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "gestor-de-inventario-wtf-29056",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".firebase/**",
      ".claude/**",
      ".githooks/**",
      ".vscode/**",
      "**/node_modules/**",
      "*.log",
      "firebase-debug.log",
      "firestore.rules",
      "storage.rules",
      "database.rules.json",
      "tmp/**",
      "backups/**",
      "output/**",
      "tools/**",
      "functions/**",
      "android-app/**",
      "icg-pruebas/**",
      "firestore-*.json",
      "API-KEY-PUSH-WEB.txt",
      "Api-KeyFirebase-*.txt",
      "Nuevo Documento de texto.txt",
      "icg-historical-*.json",
      "wtf-pos-ecosystem/**",
      "wtf-inventory-sync-service/**",
      "hosting-default-redirect/**",
      "*.md",
      "WTF_SISTEMA/**",
      "package.json",
      "WTF. SISTEMA.txt"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/firebase-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/version.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/app-version.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/pwa.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/host-enroll.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/sharp-limpieza/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
