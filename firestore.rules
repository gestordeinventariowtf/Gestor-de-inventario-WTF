rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 3;
    }

    function isProtectedAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'Henryortiz1704@gmail.com',
          'henryortiz1704@gmail.com',
          'wtfoodrdav.venezuela@gmail.com'
        ];
    }

    function authUserDoc() {
      return /databases/$(database)/documents/authorizedUsers/$(request.auth.token.email);
    }

    function hasAuthorizedUserDoc() {
      return signedIn() && exists(authUserDoc());
    }

    function isAuthorizedUser() {
      return hasAuthorizedUserDoc()
        && get(authUserDoc()).data.active == true;
    }

    function isAuthorizedAdmin() {
      return hasAuthorizedUserDoc()
        && get(authUserDoc()).data.active == true
        && get(authUserDoc()).data.role == 'admin';
    }

    function icgEmergencyPauseActive() {
      return exists(/databases/$(database)/documents/wtfSistema/icgControl)
        && get(/databases/$(database)/documents/wtfSistema/icgControl).data.inventoryImpactPaused == true;
    }

    function isExternalStateDocument(docId) {
      return docId in [
        'regEntradas',
        'regSalidas',
        'regDecomiso',
        'regRecuento',
        'regProduccion',
        'histEntradaRapida',
        'histSalidaRapida',
        'histDecomisoCocina',
        'barRegEntradas',
        'barRegSalidas',
        'barRegDecomiso',
        'barRegRecuento',
        'barRegProduccion',
        'barHistEntradaRapida',
        'barHistSalidaRapida'
      ];
    }

    match /authorizedUsers/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow list: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin()
        || (isProtectedAdminEmail() && email == request.auth.token.email);
      allow delete: if isAuthorizedAdmin()
        && !(email in ['Henryortiz1704@gmail.com', 'henryortiz1704@gmail.com']);
    }

    match /wtfSistema/estadoGeneral {
      allow read, write: if isAuthorizedUser();
    }

    match /wtfSistema/icgControl {
      allow read, write: if isAuthorizedUser();
    }

    match /wtfSistema/icgFrontRestData {
      allow read, write: if isAuthorizedUser();
    }

    match /wtfSistema/systemLogs {
      allow read: if isAuthorizedUser();
      allow write: if false;

      match /events/{logId} {
        allow read: if isAuthorizedUser();
        allow create: if isAuthorizedUser()
          && request.resource.data.id == logId
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.accion is string
          && request.resource.data.modulo is string
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAuthorizedAdmin();
      }

      match /meta/{metaId} {
        allow read, write: if isAuthorizedUser()
          && metaId == 'state';
      }
    }

    match /wtfSistema/syncIndex {
      allow read, write: if isAuthorizedUser();
    }

    match /wtfSistema/{externalStateDoc} {
      allow read, write: if isAuthorizedUser() && isExternalStateDocument(externalStateDoc);
    }

    match /wtfSistema/estadoGeneral/stateShards/{shardId} {
      allow read: if isAuthorizedUser();
      allow write: if isAuthorizedUser()
        && (shardId != 'icgFrontRestData'
          || !icgEmergencyPauseActive()
          || !exists(/databases/$(database)/documents/wtfSistema/estadoGeneral/stateShards/$(shardId))
          || request.resource.data.appStateCompressed == resource.data.appStateCompressed);
    }

    match /pwaPushSubscriptions/{subscriptionId} {
      allow create, update: if isAuthorizedUser()
        && subscriptionId.matches('^[A-Za-z0-9_-]{1,140}$')
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 20
        && request.resource.data.endpoint.size() <= 1200
        && request.resource.data.subscription is map;
      allow read, delete: if false;
    }

    match /pwaPushMessages/{messageId} {
      allow read: if isAuthorizedUser();
      allow create: if isAuthorizedUser()
        && request.resource.data.status == 'pending'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 500
        && (!('topic' in request.resource.data) || request.resource.data.topic is string && request.resource.data.topic.size() <= 40)
        && (!('url' in request.resource.data) || request.resource.data.url is string && request.resource.data.url.size() <= 240);
      allow update, delete: if false;
    }

    match /authorizedTerminals/{terminalId} {
      allow read, write, delete: if false;
    }

    match /terminalAuditLogs/{logId} {
      allow read, write, delete: if false;
    }

    function isSharpModule(moduleId) {
      return moduleId in ['cocina', 'servicio'];
    }

    function canUseSharp() {
      return isAuthorizedAdmin()
        || (hasAuthorizedUserDoc()
          && get(authUserDoc()).data.active == true
          && (
            get(authUserDoc()).data.modulo in ['sharp', 'ambos', 'cocina_bar']
            || ('permisos' in get(authUserDoc()).data && 'sharp' in get(authUserDoc()).data.permisos)
          ));
    }

    match /sharpLimpieza/config/settings/branchConfig {
      allow read, write: if canUseSharp();
    }

    match /sharpLimpieza/libraries/modules/{moduleId} {
      allow read, write: if canUseSharp()
        && isSharpModule(moduleId)
        && (!('libraryJson' in request.resource.data)
          || request.resource.data.libraryJson is string
          && request.resource.data.libraryJson.size() <= 9000000);
    }

    match /sharpLimpieza/boards/items/{boardId} {
      allow read: if canUseSharp();
      allow write: if canUseSharp()
        && boardId.matches('^[A-Za-z0-9_-]{1,120}$')
        && request.resource.data.stateJson is string
        && request.resource.data.stateJson.size() <= 9000000;
    }

    match /sharpLimpieza/photoIndex/{moduleId}/{dateKey}/photos/{photoId} {
      allow read: if canUseSharp() && isSharpModule(moduleId);
      allow create, update: if canUseSharp()
        && isSharpModule(moduleId)
        && dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.url is string
        && request.resource.data.url.matches('^https://firebasestorage\\.googleapis\\.com/')
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^sharp-limpieza/' + moduleId + '/' + dateKey + '/')
        && request.resource.data.contentType == 'image/jpeg'
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size <= 2 * 1024 * 1024;
      allow delete: if canUseSharp() && isSharpModule(moduleId);
    }

    match /sharpLimpieza/photoIndex/{moduleId}/{dateKey} {
      allow read, write, delete: if canUseSharp()
        && isSharpModule(moduleId)
        && dateKey.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }
  }
}
