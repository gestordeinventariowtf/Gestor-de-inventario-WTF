rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'Henryortiz1704@gmail.com',
          'henryortiz1704@gmail.com'
        ];
    }

    function isAuthorizedWtfUser() {
      return request.auth != null
        && (
          isAuthorizedAdmin()
          || (
            firestore.exists(/databases/(default)/documents/authorizedUsers/$(request.auth.token.email))
            && firestore.get(/databases/(default)/documents/authorizedUsers/$(request.auth.token.email)).data.active == true
          )
        );
    }

    match /sharp-limpieza/{moduleId}/{dateKey}/{fileName} {
      allow read: if isAuthorizedWtfUser() && moduleId in ['cocina', 'servicio'];
      allow create, update: if isAuthorizedWtfUser()
        && moduleId in ['cocina', 'servicio']
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isAuthorizedWtfUser() && moduleId in ['cocina', 'servicio'];
    }

    match /activo-operativo/{category}/{fileName} {
      allow read: if isAuthorizedAdmin();
      allow create, update: if isAuthorizedAdmin()
        && request.resource != null
        && request.resource.size <= 1 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isAuthorizedAdmin();
    }
  }
}
