rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.size() > 3;
    }

    function isProtectedAdminEmail() {
      return signedIn()
        && request.auth.token.email in [
          'Henryortiz1704@gmail.com',
          'henryortiz1704@gmail.com',
          'wtfoodrdav.venezuela@gmail.com'
        ];
    }

    function authUserDoc() {
      return /databases/(default)/documents/authorizedUsers/$(request.auth.token.email);
    }

    function hasAuthorizedUserDoc() {
      return signedIn() && firestore.exists(authUserDoc());
    }

    function isAuthorizedUser() {
      return isProtectedAdminEmail()
        || (hasAuthorizedUserDoc()
          && firestore.get(authUserDoc()).data.active == true);
    }

    function isAuthorizedAdmin() {
      return isProtectedAdminEmail()
        || (hasAuthorizedUserDoc()
          && firestore.get(authUserDoc()).data.active == true
          && firestore.get(authUserDoc()).data.role == 'admin');
    }

    function canUseSharp() {
      return isAuthorizedAdmin()
        || (hasAuthorizedUserDoc()
          && firestore.get(authUserDoc()).data.active == true
          && (
            firestore.get(authUserDoc()).data.modulo in ['sharp', 'ambos', 'cocina_bar']
            || ('permisos' in firestore.get(authUserDoc()).data && 'sharp' in firestore.get(authUserDoc()).data.permisos)
          ));
    }

    match /sharp-limpieza/{moduleId}/{dateKey}/{fileName} {
      allow read: if canUseSharp() && moduleId in ['cocina', 'servicio'];
      allow create, update: if canUseSharp()
        && moduleId in ['cocina', 'servicio']
        && request.resource != null
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if canUseSharp() && moduleId in ['cocina', 'servicio'];
    }

    match /activo-operativo/{category}/{fileName} {
      allow read: if isAuthorizedUser();
      allow create, update: if isAuthorizedUser()
        && request.resource != null
        && request.resource.size <= 1 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
      allow delete: if isAuthorizedAdmin();
    }
  }
}
